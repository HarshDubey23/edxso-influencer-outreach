# Discovery: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Personalization: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=8

# Sending
SENDER_NAME=Partnerships Team, EDXSO
SENDER_EMAIL=
# test mode redirects every email here (your own inbox)
TEST_RECIPIENT=

# SMTP transport (Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# n8n transport (production URL of the "EDXSO Outreach Sender" webhook workflow)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
