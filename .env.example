# Discovery: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Personalization: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=8

# Sending
SENDER_NAME=Partnerships Team, EDXSO
SENDER_EMAIL=
# test mode redirects every email here (your own inbox)
TEST_RECIPIENT=

# SMTP transport (Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# n8n transport (production URL of the "EDXSO Outreach Sender" webhook workflow)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Self-hosted control room
# long random string; encrypts the Gmail token and signs links
SECRET_KEY=
# password for the control room
ADMIN_PASSWORD=
# public URL of this install (unsubscribe links, OAuth redirect)
BASE_URL=http://localhost:8000
# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# show only your own campaign, not the bundled demo niches
WORKSPACE_ONLY=1
# lets the n8n agent call /api/live/* with an x-api-key header
API_TOKEN=
